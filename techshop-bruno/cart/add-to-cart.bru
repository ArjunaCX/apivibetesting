meta {
  name: Add To Cart
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/cart
  body: json
  auth: bearer
}

auth:bearer {
  token: {{authToken}}
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "productId": 1,
    "quantity": 2
  }
}

assert {
  res.status: eq 201
}

script:post-response {
  const body = res.body;
  if (body && body.items && body.items.length) {
    bru.setEnvVar("cartItemId", String(body.items[body.items.length - 1].id));
  } else if (body && body.id) {
    bru.setEnvVar("cartItemId", String(body.id));
  }
}
