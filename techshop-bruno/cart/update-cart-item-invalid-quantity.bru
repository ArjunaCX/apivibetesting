meta {
  name: Update Cart Item Invalid Quantity
  type: http
  seq: 8
}

put {
  url: {{baseUrl}}/cart/{{cartItemId}}
  body: json
  auth: bearer
}

auth:bearer {
  token: {{authToken}}
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "quantity": 0
  }
}

assert {
  res.status: eq 400
}
